{
  "name": "@agentdocs/crawler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "corepack pnpm --filter @agentdocs/normalizer build",
    "test": "vitest run src",
    "pretypecheck": "corepack pnpm --filter @agentdocs/normalizer build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentdocs/normalizer": "workspace:*",
    "@agentdocs/shared": "workspace:*",
    "cheerio": "^1.1.0",
    "fast-xml-parser": "^5.10.0",
    "minimatch": "^10.0.3"
  },
  "devDependencies": {
    "vitest": "4.1.9"
  }
}
