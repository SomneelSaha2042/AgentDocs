{
  "name": "@agentdocs/normalizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "pnpm --filter @agentdocs/shared build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @agentdocs/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5"
  },
  "dependencies": {
    "@agentdocs/shared": "workspace:*",
    "cheerio": "^1.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "turndown": "^7.2.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.0"
  }
}
